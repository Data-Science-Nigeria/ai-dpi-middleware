# Client registry — each entry maps client_id -> { secret, roles }
# Available roles: admin, user, readonly
CLIENTS={"app1":{"secret":"change-me","roles":["user"]},"admin-app":{"secret":"change-me","roles":["admin","user"]}}

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# OIDC — optional, enables external provider token validation
OIDC_ISSUER=https://your-idp.example.com
OIDC_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
OIDC_AUDIENCE=your-api-audience

# OAuth2 flows — optional, enables /v1/auth/oauth2/* endpoints
OAUTH2_CLIENT_ID=your-oauth2-client-id
OAUTH2_CLIENT_SECRET=your-oauth2-client-secret
OAUTH2_AUTHORIZATION_ENDPOINT=https://your-idp.example.com/oauth2/authorize
OAUTH2_TOKEN_ENDPOINT=https://your-idp.example.com/oauth2/token
OAUTH2_REDIRECT_URI=http://localhost:8000/v1/auth/oauth2/callback
OAUTH2_SCOPES=["openid","profile","email"]

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — required for TTS with provider=openai
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Groq — required for TTS endpoints (/v1/tts/synthesize)
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Default model used for Groq chat (not TTS — TTS model is set per-request)
GROQ_MODEL=groq-1.5-pro

# Redis
REDIS_URL=redis://localhost:6379/0
OAUTH2_STATE_TTL_SECONDS=300

# Optional
DEBUG=false
CORS_ORIGINS=["*"]
