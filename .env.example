# OAuth2 / OIDC — replace with your provider's values
OAUTH_ISSUER=https://your-idp.example.com
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_AUDIENCE=your-api-audience        # leave empty if not checking audience
JWKS_URI=https://your-idp.example.com/.well-known/jwks.json

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional overrides
DEBUG=false
CORS_ORIGINS=["*"]